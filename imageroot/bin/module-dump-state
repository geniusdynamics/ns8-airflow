#

# Runs before the restic backup, with state/ as working directory. The
# application keeps running: pg_dump takes a consistent snapshot.
set -euo pipefail
exec 1>&2
umask 077

if ! systemctl --user is-active --quiet airflow-db.service; then
    echo "airflow-db.service is not running: no database dump written" >&2
    rm -f airflow.pg_dump
    exit 0
fi

tmpfile=$(mktemp -p "$PWD" airflow.pg_dump.XXXXXX)
trap 'rm -f "$tmpfile"' EXIT
podman exec airflow-db pg_dump -U airflow --format=c airflow > "$tmpfile"
test -s "$tmpfile"
mv -f "$tmpfile" airflow.pg_dump
echo "Database dump written to airflow.pg_dump"
