#!/bin/bash
set -euo pipefail
umask 077
running=false
if systemctl --user is-active --quiet airflow.service; then running=true; fi
finish() {
    status=$?
    rm -f "${tempfile:-}"
    if "$running"; then systemctl --user start airflow.service airflow-db.service airflow-web.service airflow-scheduler.service airflow-dag-processor.service airflow-triggerer.service || status=1; fi
    exit "$status"
}
trap finish EXIT
if "$running"; then systemctl --user stop airflow.service; fi
for volume in airflow-data airflow-db; do
    tempfile=$(mktemp -p "$PWD")
    podman unshare bash -ec 'tar --numeric-owner -C "$(podman volume mount "$1")" -cpf "$2" .' bash "$volume" "$tempfile"
    mv -f "$tempfile" "$volume.tar"
done
