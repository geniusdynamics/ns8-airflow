#!/bin/bash

#
# Print the initial Airflow administrator credentials. Usage, on the node:
#   runagent -m airflow1 airflow-initial-credentials
#
# The password is the one generated at module creation. If it was changed
# from the Airflow web interface, this file is out of date.
#
set -e
printf 'Username: admin\n'
sed -n 's/^NS8_ADMIN_PASSWORD=/Password: /p' "${AGENT_STATE_DIR}/admin.env"
