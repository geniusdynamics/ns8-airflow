import json
import sys
import agent

data = json.load(sys.stdin)
host = data["host"]

agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", data.get("http2https", True))
# Non-secret: public URL of the web interface, as seen through Traefik
agent.set_env("AIRFLOW__API__BASE_URL", "https://" + host)
