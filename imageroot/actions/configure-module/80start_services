set -e
exec 1>&2
systemctl --user enable airflow.service
# List every unit explicitly: the pod does not cascade the restart to its
# children. Order: pod, database, web (runs the DB init), background services.
systemctl --user restart airflow.service airflow-db.service airflow-web.service \
    airflow-scheduler.service airflow-dag-processor.service airflow-triggerer.service
