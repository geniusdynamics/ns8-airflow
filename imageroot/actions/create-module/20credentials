#
# Generate the module secrets once, at creation time. Every file is created
# with mode 0600 and never overwritten. Secrets are kept out of Redis
# (agent.set_env) and are injected into the containers with --env-file.
#
#   state/database.env  PostgreSQL credentials (database container only)
#   state/airflow.env   Airflow keys and connection string (Airflow containers)
#   state/admin.env     initial admin password (init step only)
#

import base64
import os
import secrets

state = os.environ["AGENT_STATE_DIR"]


def write_secret_file(name, values):
    path = os.path.join(state, name)
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        return
    with os.fdopen(fd, "w") as f:
        for key, value in values.items():
            f.write(f"{key}={value}\n")


db_password = secrets.token_hex(32)

write_secret_file("database.env", {
    "POSTGRES_USER": "airflow",
    "POSTGRES_DB": "airflow",
    "POSTGRES_PASSWORD": db_password,
})

write_secret_file("airflow.env", {
    "AIRFLOW__DATABASE__SQL_ALCHEMY_CONN": f"postgresql+psycopg2://airflow:{db_password}@127.0.0.1/airflow",
    "AIRFLOW__CORE__FERNET_KEY": base64.urlsafe_b64encode(os.urandom(32)).decode(),
    "AIRFLOW__API_AUTH__JWT_SECRET": secrets.token_hex(32),
    "AIRFLOW__API__SECRET_KEY": secrets.token_hex(32),
    "AIRFLOW__CORE__EXECUTOR": "LocalExecutor",
    "AIRFLOW__CORE__LOAD_EXAMPLES": "False",
    "AIRFLOW__CORE__AUTH_MANAGER": "airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager",
    "AIRFLOW__CORE__EXECUTION_API_SERVER_URL": "http://127.0.0.1:8080/execution/",
    "AIRFLOW__CORE__PARALLELISM": "8",
    "AIRFLOW__FAB__ENABLE_PROXY_FIX": "True",
    "FORWARDED_ALLOW_IPS": "*",
})

write_secret_file("admin.env", {
    "NS8_ADMIN_PASSWORD": secrets.token_urlsafe(24),
})
