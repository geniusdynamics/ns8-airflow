#!/usr/bin/env python3
import json
import os
from pathlib import Path
import secrets

state = Path(os.environ["AGENT_STATE_DIR"])
os.umask(0o077)
config = state / "airflow.env"
if not config.exists():
    password = secrets.token_urlsafe(32)
    database_password = secrets.token_hex(32)
    key = secrets.token_urlsafe(32) + "="
    database_url = f"postgresql+psycopg2://airflow:{database_password}@127.0.0.1/airflow"
    values = {
        "POSTGRES_USER": "airflow", "POSTGRES_DB": "airflow",
        "POSTGRES_PASSWORD": database_password,
        "NS8_ADMIN_PASSWORD": password,
        "AIRFLOW__DATABASE__SQL_ALCHEMY_CONN": database_url,
        "AIRFLOW__CORE__EXECUTOR": "LocalExecutor",
        "AIRFLOW__CORE__LOAD_EXAMPLES": "False",
        "AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS": "admin:admin",
        "AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE": "/opt/airflow/ns8-admin.json",
        "AIRFLOW__CORE__FERNET_KEY": key,
        "AIRFLOW__API_AUTH__JWT_SECRET": secrets.token_hex(32),
        "AIRFLOW__API__SECRET_KEY": secrets.token_hex(32),
        "AIRFLOW__CORE__EXECUTION_API_SERVER_URL": "http://127.0.0.1:8080/execution/",
        "AIRFLOW__CORE__PARALLELISM": "8",
    }
    (state / "ns8-admin.json").write_text(json.dumps({"admin": password}) + "\n")
    config.write_text("".join(f"{name}={value}\n" for name, value in values.items()))
