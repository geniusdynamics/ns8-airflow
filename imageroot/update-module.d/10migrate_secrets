# Early instances kept every secret in state/airflow.env. Split it so that the
# database container and the services do not receive secrets they do not need.
import os

state = os.environ["AGENT_STATE_DIR"]
old = os.path.join(state, "airflow.env")


def read(path):
    with open(path) as f:
        return [line.rstrip("\n") for line in f if "=" in line]


def create(name, lines):
    path = os.path.join(state, name)
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        return
    with os.fdopen(fd, "w") as f:
        f.write("".join(line + "\n" for line in lines))


if os.path.exists(old):
    lines = read(old)
    create("database.env", [l for l in lines if l.startswith("POSTGRES_")])
    create("admin.env", [l for l in lines if l.startswith("NS8_ADMIN_PASSWORD=")])
    rest = [l for l in lines if not l.startswith(("POSTGRES_", "NS8_ADMIN_PASSWORD="))]
    extra = [l for l in ("AIRFLOW__FAB__ENABLE_PROXY_FIX=True", "FORWARDED_ALLOW_IPS=*")
             if l.split("=")[0] not in [r.split("=")[0] for r in rest]]
    tmp = old + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("".join(l + "\n" for l in rest + extra))
    os.replace(tmp, old)
