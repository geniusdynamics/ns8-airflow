[Unit]
Description=Apache Airflow PostgreSQL database
BindsTo=airflow.service
PartOf=airflow.service
After=airflow.service

[Service]
Type=notify
NotifyAccess=all
EnvironmentFile=%E/state/environment
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=75
ExecStart=/usr/bin/podman run --pod airflow --env-file=%E/state/database.env --volume airflow-db:/var/lib/postgresql/data:Z --replace --name %N --sdnotify=conmon --cgroups=no-conmon ${POSTGRES_IMAGE}
# Healthcheck: the unit is "started" only when PostgreSQL accepts connections
ExecStartPost=/usr/bin/timeout 120 /usr/bin/bash -c 'until podman exec %N pg_isready -h 127.0.0.1 -U airflow -d airflow -q; do sleep 2; done'
ExecStop=/usr/bin/podman stop --ignore -t 30 %N
ExecStopPost=/usr/bin/podman rm --ignore -f %N
