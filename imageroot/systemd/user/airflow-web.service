[Unit]
Description=Apache Airflow web
BindsTo=airflow.service
PartOf=airflow.service
After=airflow.service airflow-db.service

[Service]
Type=notify
NotifyAccess=all
EnvironmentFile=%E/state/environment
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=75
ExecStartPre=/usr/bin/podman run --pod airflow --env-file=%E/state/airflow.env --volume airflow-data:/opt/airflow:Z,U --rm --volume %E/etc/airflow-init.sh:/opt/ns8-init.sh:ro,Z ${AIRFLOW_IMAGE} bash /opt/ns8-init.sh
ExecStart=/usr/bin/podman run --pod airflow --env-file=%E/state/airflow.env --volume airflow-data:/opt/airflow:Z,U --replace --name %N --sdnotify=conmon --cgroups=no-conmon ${AIRFLOW_IMAGE} api-server
ExecStartPost=/usr/bin/timeout 120 /usr/bin/bash -c 'until curl -fsS "http://127.0.0.1:${TCP_PORT}/api/v2/version" >/dev/null; do sleep 2; done'
ExecStop=/usr/bin/podman stop --ignore -t 30 %N
ExecStopPost=/usr/bin/podman rm --ignore -f %N
