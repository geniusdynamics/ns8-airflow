[Unit]
Description=Apache Airflow triggerer
BindsTo=airflow.service
PartOf=airflow.service
After=airflow.service airflow-db.service airflow-web.service

[Service]
Type=notify
NotifyAccess=all
EnvironmentFile=%E/state/environment
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=75
ExecStart=/usr/bin/podman run --pod airflow --env-file=%E/state/airflow.env --volume airflow-data:/opt/airflow:Z,U --volume %E/state/ns8-admin.json:/opt/airflow/ns8-admin.json:ro,Z,U --replace --name %N --sdnotify=conmon --cgroups=no-conmon ${AIRFLOW_IMAGE} triggerer
ExecStop=/usr/bin/podman stop --ignore -t 30 %N
ExecStopPost=/usr/bin/podman rm --ignore -f %N
